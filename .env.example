# Openstage — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# AI providers (deck generation, chat, image generation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub App — deck deploys via branches/PRs and in-app feedback → issues
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPO_OWNER=alibad
GITHUB_REPO_NAME=openstage

# Site gating
SITE_PASSWORD=
ADMIN_PASSWORD=

# Azure AD sign-in (optional — only if enterprise SSO is enabled)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Vercel Blob — uploaded assets (feedback screenshots, recordings)
BLOB_READ_WRITE_TOKEN=
