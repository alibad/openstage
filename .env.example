# Openstage — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# AI providers (deck generation, chat, image generation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub App — deck deploys via branches/PRs and in-app feedback → issues.
# All four are required for feedback to file issues (src/lib/github.ts bails
# without APP_ID + INSTALLATION_ID + PRIVATE_KEY). The App must also be
# installed on the target repo.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPO_OWNER=alibad
GITHUB_REPO_NAME=openstage

# Admin gate — protects /admin (the AI studio) and /fb. When unset, both are
# OPEN, so always set it in production. Decks are public unless their
# registry entry sets `visibility` or `protected`; there is no site-wide gate.
ADMIN_PASSWORD=

# Optional — Vercel Blob for feedback attachments (screenshots, recordings).
# Text feedback still files without it.
BLOB_READ_WRITE_TOKEN=

# Optional — Azure AD sign-in, only if enterprise SSO is enabled
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
